{
  "name": "billy-app",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "mobile": "npm run start --workspace @billy/mobile",
    "android": "npm run android --workspace @billy/mobile",
    "ios": "npm run ios --workspace @billy/mobile",
    "web": "npm run web --workspace @billy/mobile",
    "lint": "npm run lint --workspace @billy/mobile",
    "typecheck": "npm run typecheck --workspace @billy/mobile",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:status": "supabase status"
  },
  "devDependencies": {
    "supabase": "2.109.1"
  },
  "engines": {
    "node": ">=22"
  }
}
