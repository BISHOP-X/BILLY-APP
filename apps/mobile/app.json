{
  "expo": {
    "name": "Billy",
    "slug": "billy-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/brand/billy-mark.png",
    "scheme": "billy",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.bishopx.billy",
      "supportsTablet": false,
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.bishopx.billy",
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#146237",
        "foregroundImage": "./assets/brand/billy-mark-adaptive.png"
      },
      "predictiveBackGestureEnabled": true
    },
    "web": {
      "output": "single",
      "favicon": "./assets/brand/billy-mark.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "asyncRoutes": {
            "web": true,
            "android": false,
            "ios": false,
            "default": "development"
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F5F6F3",
          "dark": {
            "backgroundColor": "#0C1511",
            "image": "./assets/brand/billy-mark.png"
          },
          "image": "./assets/brand/billy-mark.png",
          "imageWidth": 104
        }
      ],
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Billy to select gift card images you choose to submit for a sale.",
          "microphonePermission": false
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow Billy to use Face ID to securely unlock your account."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "6e07d9bf-d7ae-4358-b6fd-99c353f4ca1b"
      }
    },
    "owner": "bishop-xs-team"
  }
}
