{
  "expo": {
    "name": "Billy",
    "slug": "billy",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/brand/billy-mark.png",
    "scheme": "billy",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#146237",
        "foregroundImage": "./assets/brand/billy-mark-adaptive.png"
      },
      "predictiveBackGestureEnabled": true
    },
    "web": {
      "output": "static",
      "favicon": "./assets/brand/billy-mark.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B4829",
          "dark": {
            "backgroundColor": "#08130D",
            "image": "./assets/brand/billy-wordmark-transparent.png"
          },
          "image": "./assets/brand/billy-wordmark-transparent.png",
          "imageWidth": 230
        }
      ],
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Billy to select gift card images you choose to submit for a sale."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow Billy to use Face ID to securely unlock your account."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
