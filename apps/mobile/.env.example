# Safe to expose in the compiled mobile application.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Approved, public HTTPS documents and immutable version identifiers.
# Production account creation remains disabled until all four are configured.
EXPO_PUBLIC_TERMS_URL=
EXPO_PUBLIC_TERMS_VERSION=
EXPO_PUBLIC_PRIVACY_URL=
EXPO_PUBLIC_PRIVACY_VERSION=

# Main app data source. Keep `supabase` for normal use. `demo` is accepted only
# in development builds and is always labelled in the UI.
EXPO_PUBLIC_BILLY_DATA_MODE=supabase
# funded | new-user | pending | maintenance | offline | error
EXPO_PUBLIC_BILLY_DEMO_SCENARIO=funded
