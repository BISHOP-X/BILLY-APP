# Safe to expose in the compiled mobile application.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Keep hidden until the matching provider is configured and verified in the
# Billy Supabase project. These values are safe public feature switches.
EXPO_PUBLIC_GOOGLE_AUTH_ENABLED=true
EXPO_PUBLIC_GOOGLE_AUTH_WEB_CLIENT_ID=
EXPO_PUBLIC_APPLE_AUTH_ENABLED=false

# Approved public documents. These defaults are also compiled into the app so
# Android, iOS, and web builds record the same immutable acceptance versions.
EXPO_PUBLIC_TERMS_URL=https://billyapp.org/terms
EXPO_PUBLIC_TERMS_VERSION=2026-09-02
EXPO_PUBLIC_PRIVACY_URL=https://billyapp.org/privacy
EXPO_PUBLIC_PRIVACY_VERSION=2026-09-02

# Main app data source. Keep `supabase` for normal use. `demo` is accepted only
# in development builds and is always labelled in the UI.
EXPO_PUBLIC_BILLY_DATA_MODE=supabase
# funded | new-user | pending | maintenance | offline | error
EXPO_PUBLIC_BILLY_DEMO_SCENARIO=funded
