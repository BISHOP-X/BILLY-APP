{
  "cli": {
    "appVersionSource": "remote",
    "requireCommit": true,
    "version": ">= 21.3.0"
  },
  "build": {
    "tester": {
      "distribution": "internal",
      "environment": "preview",
      "env": {
        "EXPO_PUBLIC_BILLY_DATA_MODE": "supabase"
      },
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": false
      }
    },
    "production": {
      "distribution": "store",
      "environment": "production",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_BILLY_DATA_MODE": "supabase"
      }
    }
  }
}
